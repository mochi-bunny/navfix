{
    def Scope "Looks"
    {
        def Material "floor"
        {
            token outputs:surface.connect = </Warehouse/Looks/floor/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.11, 0.13)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
